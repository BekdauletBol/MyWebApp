@model List<Feedback>

@{
    ViewData["Title"] = "Админка — Сообщения";
}

<section class="admin-header">
    <h1>Админ-панель</h1>
    <div class="admin-nav">
        <a asp-controller="Admin" asp-action="Index" class="admin-link active">Сообщения</a>
        <a asp-controller="Admin" asp-action="Projects" class="admin-link">Проекты</a>
        <a asp-controller="Admin" asp-action="Blog" class="admin-link">Блог</a>
    </div>
</section>

<section class="admin-table">
    @if (!Model.Any())
    {
        <p style="color: var(--muted);">Пока нет сообщений.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Имя</th>
                    <th>Email</th>
                    <th>Сообщение</th>
                    <th>Дата</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model)
                {
                    <tr>
                        <td>@f.Name @f.Surname</td>
                        <td>@f.Email</td>
                        <td>@f.Message</td>
                        <td>@f.CreatedAt.ToString("dd.MM.yyyy")</td>
                        <td>
                            <form method="post" asp-controller="Admin" asp-action="DeleteFeedback" asp-route-id="@f.Id">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-delete">Удалить</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

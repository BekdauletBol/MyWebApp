@model List<Project>

@{
    ViewData["Title"] = "Админка — Проекты";
}

<section class="admin-header">
    <h1>Админ-панель</h1>
    <div class="admin-nav">
        <a asp-controller="Admin" asp-action="Index" class="admin-link">Сообщения</a>
        <a asp-controller="Admin" asp-action="Projects" class="admin-link active">Проекты</a>
        <a asp-controller="Admin" asp-action="Blog" class="admin-link">Блог</a>
    </div>
    <a asp-controller="Admin" asp-action="CreateProject" class="btn" style="margin-left: auto;">+ Проект</a>
</section>

<section class="admin-table">
    <table>
        <thead>
            <tr>
                <th>Название</th>
                <th>Технологии</th>
                <th>Дата</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Title</td>
                    <td>@p.TechStack</td>
                    <td>@p.CreatedAt.ToString("dd.MM.yyyy")</td>
                    <td>
                        <form method="post" asp-controller="Admin" asp-action="DeleteProject" asp-route-id="@p.Id">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-delete">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>

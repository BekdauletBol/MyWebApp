<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Бекдаулет</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <a class="logo" asp-controller="Home" asp-action="Index">bekdev</a>
        <nav>
            <a asp-controller="Home" asp-action="Index">Главная</a>
            <a asp-controller="Projects" asp-action="Index">Проекты</a>
            <a asp-controller="Blog" asp-action="Index">Блог</a>
            <a asp-controller="Feedbacks" asp-action="Index">Связь</a>
            <a asp-controller="Home" asp-action="About">Обо мне</a>
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
    <footer>
        <div class="footer-content">
            <span class="footer-logo">bekdev</span>
            <span>&copy; 2026. Сделано с помощью ASP.NET Core</span>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

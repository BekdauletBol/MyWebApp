@model Feedback

@{
    ViewData["Title"] = "Обратная связь";
}

<section class="feedback">
    <div class="feedback-header">
        <span class="hero-label">Contact</span>
        <h1>Связаться <span class="accent">со мной</span></h1>
        <p>Есть вопрос или идея? Напишите, и я отвечу.</p>
    </div>

    <form method="post" asp-controller="Feedbacks" asp-action="Create">
        @Html.AntiForgeryToken()
        <div class="form-row">
            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" placeholder="Ваше имя" />
                <span asp-validation-for="Name"></span>
            </div>
            <div class="form-group">
                <label asp-for="Surname"></label>
                <input asp-for="Surname" placeholder="Ваша фамилия" />
                <span asp-validation-for="Surname"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Age"></label>
                <input asp-for="Age" type="number" placeholder="Ваш возраст" />
                <span asp-validation-for="Age"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" type="email" placeholder="you@example.com" />
                <span asp-validation-for="Email"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Message"></label>
            <textarea asp-for="Message" placeholder="Ваше сообщение..."></textarea>
            <span asp-validation-for="Message"></span>
        </div>

        <button type="submit">Отправить &rarr;</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
